<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/org.lineageos.device.DeviceSettings"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="audio_share_master_switch"
        android:title="@string/audio_share_enable"
        android:summary="@string/audio_share_enable_summary"
        android:icon="@drawable/ic_audio_share"
        android:defaultValue="false" />

    <!-- Headsets and the Start/Stop button -->
    <PreferenceCategory
        android:key="category_devices"
        android:dependency="audio_share_master_switch"
        android:title="@string/audio_share_devices_category">

        <Preference
            android:key="primary_device_info"
            android:title="@string/audio_share_primary_device"
            android:summary="@string/audio_share_no_primary_device"
            android:icon="@drawable/ic_volume_up" />

        <ListPreference
            android:key="secondary_device_select"
            android:title="@string/audio_share_secondary_device"
            android:summary="@string/audio_share_secondary_device_summary"
            android:icon="@drawable/ic_dock_share"
            android:persistent="false" />

        <Preference
            android:key="audio_share_swap_roles"
            android:title="@string/audio_share_swap_roles"
            android:summary="@string/audio_share_swap_roles_summary"
            android:icon="@drawable/ic_swap"
            android:persistent="false" />

        <org.lineageos.device.DeviceSettings.audioshare.ShareButtonPreference
            android:key="secondary_share_action"
            android:title="@string/audio_share_status_idle_title"
            android:summary="@string/audio_share_idle_status"
            android:persistent="false" />

    </PreferenceCategory>

    <!-- Volume -->
    <PreferenceCategory
        android:key="category_volume"
        android:dependency="audio_share_master_switch"
        android:title="@string/audio_share_volume_category">

        <org.lineageos.device.DeviceSettings.audioshare.AudioVolumePreference
            android:key="primary_device_volume"
            android:title="@string/audio_share_primary_volume"
            android:persistent="false"
            android:defaultValue="80" />

        <org.lineageos.device.DeviceSettings.audioshare.AudioVolumePreference
            android:key="secondary_device_volume"
            android:title="@string/audio_share_secondary_volume"
            android:persistent="false"
            android:defaultValue="80" />

        <SwitchPreferenceCompat
            android:key="audio_share_sync_volumes"
            android:title="@string/audio_share_sync_volumes"
            android:summary="@string/audio_share_sync_volumes_summary"
            android:icon="@drawable/ic_dock_link"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Lip sync between the two headsets -->
    <PreferenceCategory
        android:key="category_lipsync"
        android:dependency="audio_share_master_switch"
        android:title="@string/audio_share_lipsync_category">

        <SwitchPreferenceCompat
            android:key="audio_share_lipsync"
            android:title="@string/audio_share_lipsync_title"
            android:summary="@string/audio_share_lipsync_summary"
            android:icon="@drawable/ic_dock_link"
            android:persistent="false" />

        <ListPreference
            android:key="audio_share_lipsync_mode"
            android:dependency="audio_share_lipsync"
            android:title="@string/audio_share_lipsync_mode_title"
            android:entries="@array/audio_share_lipsync_mode_entries"
            android:entryValues="@array/audio_share_lipsync_mode_values"
            android:defaultValue="auto"
            android:persistent="false" />

        <!-- Per-headset adjustment, titled "<headset> plays late by" at runtime -->
        <org.lineageos.device.DeviceSettings.audioshare.AudioVolumePreference
            android:key="audio_share_adj_main"
            android:dependency="audio_share_lipsync"
            android:persistent="false" />

        <org.lineageos.device.DeviceSettings.audioshare.AudioVolumePreference
            android:key="audio_share_adj_second"
            android:dependency="audio_share_lipsync"
            android:persistent="false" />

    </PreferenceCategory>

    <!-- Sound -->
    <PreferenceCategory
        android:key="category_sound"
        android:dependency="audio_share_master_switch"
        android:title="@string/audio_share_sound_category">

        <ListPreference
            android:key="audio_share_codec"
            android:title="@string/audio_share_codec_title"
            android:icon="@drawable/ic_cpu_chip"
            android:entries="@array/audio_share_codec_entries"
            android:entryValues="@array/audio_share_codec_values"
            android:defaultValue="auto"
            android:persistent="false" />

        <Preference
            android:key="separate_app_sound_pref"
            android:title="@string/separate_app_sound_title"
            android:summary="@string/separate_app_sound_summary"
            android:icon="@drawable/ic_audio_share" />

        <SwitchPreferenceCompat
            android:key="aptx_adaptive_low_latency"
            android:defaultValue="false"
            android:title="@string/aptx_adaptive_low_latency_title"
            android:summary="@string/aptx_adaptive_low_latency_summary" />

    </PreferenceCategory>

    <!-- Advanced: not needed for sharing, which works with offload on -->
    <PreferenceCategory
        android:key="category_hardware_info"
        android:title="@string/audio_share_hardware_category">

        <SwitchPreferenceCompat
            android:key="bluetooth_a2dp_hw_offload"
            android:title="@string/bluetooth_a2dp_hw_offload_title"
            android:summary="@string/bluetooth_a2dp_hw_offload_summary_on"
            android:icon="@drawable/ic_cpu_chip"
            android:persistent="false"
            android:defaultValue="true" />

        <Preference
            android:key="hardware_engine_info"
            android:icon="@drawable/ic_info_outline"
            android:selectable="false" />

    </PreferenceCategory>

    <Preference
        android:key="audio_share_info"
        android:icon="@drawable/ic_info_outline"
        android:summary="@string/audio_share_desc_info"
        android:selectable="false" />

</PreferenceScreen>

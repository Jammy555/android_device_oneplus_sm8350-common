<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dock_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:padding="8dp">

    <!-- Card Top Row: Source App Info & Drag Handle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/dock_item_app_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dock_item_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B0FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_dock_drag_handle"
            android:tint="#80FFFFFF" />

    </LinearLayout>

    <!-- Compact Image Preview Thumbnail -->
    <ImageView
        android:id="@+id/dock_item_image_preview"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="@drawable/dock_thumb_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop" />

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dock_item_btn_copy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:src="@drawable/ic_dock_copy"
            android:tint="#C0FFFFFF" />

        <ImageView
            android:id="@+id/dock_item_btn_delete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:src="@drawable/ic_dock_delete"
            android:tint="#A0FFFFFF" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock_item_card" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/dock_card_bg" android:padding="8dp"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/dock_item_text_content" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="2dp"
        android:textSize="14sp" android:lineSpacingExtra="2dp" android:includeFontPadding="false"
        android:textColor="?android:attr/textColorPrimary" android:maxLines="6" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingEnd="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/dock_item_app_icon" android:layout_width="12dp"
                    android:layout_height="12dp" android:layout_marginEnd="3dp" />
                <TextView android:id="@+id/dock_item_app_name" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1"
                    android:ellipsize="end" android:textSize="10sp" android:includeFontPadding="false"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
            <TextView android:id="@+id/dock_item_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textSize="10sp" android:includeFontPadding="false"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
        <ImageView android:id="@+id/dock_item_btn_copy" android:layout_width="44dp"
            android:layout_height="44dp" android:padding="12dp" android:src="@drawable/ic_dock_copy"
            android:tint="?android:attr/textColorSecondary" android:contentDescription="@string/dock_copy"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageView android:id="@+id/dock_item_btn_share" android:layout_width="44dp"
            android:layout_height="44dp" android:padding="12dp" android:src="@drawable/ic_dock_share"
            android:tint="?android:attr/textColorSecondary" android:contentDescription="@string/dock_share"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageView android:id="@+id/dock_item_btn_delete" android:layout_width="44dp"
            android:layout_height="44dp" android:padding="12dp" android:src="@drawable/ic_dock_delete"
            android:tint="?android:attr/textColorSecondary" android:contentDescription="@string/dock_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>

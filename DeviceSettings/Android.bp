// Android.mk is gone: Jetpack Compose only exists as Soong modules.
// Kotlin and Java sources are compiled together, so unmigrated Java screens keep working.

android_app {
    name: "DeviceSettings",

    defaults: [
        "platform_app_defaults",
        // Same as `include frameworks/base/packages/SettingsLib/common.mk` in the old Android.mk.
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp_whitelist_org.lineageos.device.xml"],

    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],

    static_libs: [
        // legacy (View based) screens
        "androidx.core_core",
        "androidx.preference_preference",

        // Kotlin + coroutines
        "kotlinx-coroutines-android",
        "kotlinx-coroutines-core",

        // Compose + Material 3 (Expressive APIs live in material3 1.4+; see MIGRATION.md)
        "androidx.activity_activity-compose",
        "androidx.activity_activity-ktx",
        "androidx.graphics_graphics-shapes",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.animation_animation",
        "androidx.compose.material3_material3",

        // device specific
        "org.lineageos.platform.internal",
        "vendor.oplus.hardware.radio-V2-java",
    ],

    libs: ["oplus-fwk"],

    kotlincflags: [
        "-Xjvm-default=all",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.device.xml",
    src: "privapp_whitelist_org.lineageos.device.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

diff --git a/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelHunOverlay.kt b/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelHunOverlay.kt
new file mode 100644
index 000000000000..404321ab2718
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelHunOverlay.kt
@@ -0,0 +1,142 @@
+/*
+ * Copyright (C) 2025-2026 AxionOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.smartpixel.ui
+
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.view.ViewTreeObserver
+import android.view.WindowManager
+import android.view.WindowManager.LayoutParams
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.smartpixel.domain.SmartPixelSettings
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.headsup.HeadsUpManager
+import com.android.systemui.statusbar.notification.headsup.OnHeadsUpChangedListener
+import com.android.systemui.statusbar.notification.row.ExpandableNotificationRow
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+
+@SysUISingleton
+class SmartPixelHunOverlay @Inject constructor(
+    @Application private val context: android.content.Context,
+    private val windowManager: WindowManager,
+    @Application private val scope: CoroutineScope,
+    private val settings: SmartPixelSettings,
+    private val headsUpManager: HeadsUpManager,
+) : OnHeadsUpChangedListener {
+
+    private var filterView: SmartPixelView? = null
+    private var controller: SmartPixelViewController? = null
+    private var trackedRow: ExpandableNotificationRow? = null
+    private var hunPercent = 0
+    private val tmpLoc = IntArray(2)
+
+    private val preDrawListener = ViewTreeObserver.OnPreDrawListener {
+        updateOverlayBounds()
+        true
+    }
+
+    fun init() {
+        settings.hunPercent.onEach { 
+            hunPercent = it
+            if (hunPercent <= 0) hideOverlay()
+            else controller?.updateConfig(hunPercent.coerceIn(SmartPixelSettings.MIN_PERCENT, SmartPixelSettings.MAX_PERCENT))
+        }.launchIn(scope)
+        headsUpManager.addListener(this)
+    }
+
+    override fun onHeadsUpStateChanged(entry: NotificationEntry, isHeadsUp: Boolean) {
+        if (hunPercent <= 0) return
+        if (isHeadsUp) {
+            val row = entry.row ?: return
+            showOverlay(row)
+        } else {
+            if (trackedRow == entry.row || !headsUpManager.hasNotifications()) {
+                hideOverlay()
+            }
+        }
+    }
+
+    override fun onHeadsUpPinned(entry: NotificationEntry) {
+        if (hunPercent <= 0) return
+        val row = entry.row ?: return
+        showOverlay(row)
+    }
+
+    override fun onHeadsUpUnPinned(entry: NotificationEntry) {
+        if (!headsUpManager.hasPinnedHeadsUp()) {
+            hideOverlay()
+        }
+    }
+
+    private fun showOverlay(row: ExpandableNotificationRow) {
+        detachLayoutListener()
+        trackedRow = row
+
+        if (filterView == null) {
+            val view = SmartPixelView(context)
+            val vc = SmartPixelViewController(view)
+
+            val params = createLayoutParams()
+            windowManager.addView(view, params)
+            vc.init()
+            vc.updateConfig(hunPercent.coerceIn(SmartPixelSettings.MIN_PERCENT, SmartPixelSettings.MAX_PERCENT))
+            filterView = view
+            controller = vc
+        } else {
+            controller?.updateConfig(hunPercent.coerceIn(SmartPixelSettings.MIN_PERCENT, SmartPixelSettings.MAX_PERCENT))
+        }
+
+        updateOverlayBounds()
+        row.viewTreeObserver.addOnPreDrawListener(preDrawListener)
+    }
+
+    private fun hideOverlay() {
+        detachLayoutListener()
+        controller?.destroy()
+        filterView?.let { windowManager.removeViewImmediate(it) }
+        filterView = null
+        controller = null
+        trackedRow = null
+    }
+
+    private fun detachLayoutListener() {
+        trackedRow?.viewTreeObserver?.removeOnPreDrawListener(preDrawListener)
+    }
+
+    private fun updateOverlayBounds() {
+        val view = filterView ?: return
+        val row = trackedRow ?: return
+        
+        row.getLocationOnScreen(tmpLoc)
+        val height = row.pinnedHeadsUpHeight
+        
+        val bounds = Rect(tmpLoc[0], tmpLoc[1], tmpLoc[0] + row.width, tmpLoc[1] + height)
+        view.clipRect = bounds
+    }
+
+    private fun createLayoutParams(): LayoutParams {
+        val params = LayoutParams(
+            LayoutParams.MATCH_PARENT,
+            LayoutParams.MATCH_PARENT,
+            LayoutParams.TYPE_SECURE_SYSTEM_OVERLAY,
+            LayoutParams.FLAG_NOT_FOCUSABLE or
+                LayoutParams.FLAG_NOT_TOUCHABLE or
+                LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                LayoutParams.FLAG_HARDWARE_ACCELERATED or
+                LayoutParams.FLAG_SHOW_WHEN_LOCKED,
+            PixelFormat.TRANSLUCENT,
+        )
+        params.title = "SmartPixelHUN"
+        params.layoutInDisplayCutoutMode = LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+        params.privateFlags = params.privateFlags or LayoutParams.PRIVATE_FLAG_TRUSTED_OVERLAY
+        return params
+    }
+}

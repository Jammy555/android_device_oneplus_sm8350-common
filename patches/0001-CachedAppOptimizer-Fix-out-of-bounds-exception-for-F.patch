From 9e579f5b841e35ab6744dbb525c07aecc291378a Mon Sep 17 00:00:00 2001
From: Jammy555 <prathap.venkata@gmail.com>
Date: Sat, 1 Aug 2026 12:19:06 +0530
Subject: [PATCH] CachedAppOptimizer: Fix out of bounds exception for FULL
 compaction flags

- Java sends COMPACT_ACTION_FILE_FLAG | COMPACT_ACTION_ANON_FLAG (3).
- The C++ array size was 3, throwing IllegalArgumentException.
- Increased array size to 4 to prevent system_server crash on FULL compaction.

Signed-off-by: Jammy555 <prathap.venkata@gmail.com>
---
 services/core/jni/com_android_server_am_CachedAppOptimizer.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp b/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
index bea833d2321a..179feed60cd3 100644
--- a/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
+++ b/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
@@ -544,7 +544,8 @@ static void com_android_server_am_CachedAppOptimizer_compactNativeProcess(JNIEnv
 
 static jboolean com_android_server_am_CachedAppOptimizer_compactionFlagsValidForMemcg(
         JNIEnv* env, jobject, jint compactionFlags) {
-    static std::array<std::optional<bool>, 3> valid;
+    // Size 4 to cover COMPACT_ACTION_FILE_FLAG | COMPACT_ACTION_ANON_FLAG combined value of 3
+    static std::array<std::optional<bool>, 4> valid;
 
     if (compactionFlags >= valid.size() || compactionFlags < 0) {
         jniThrowException(env, "java/lang/IllegalArgumentException", "Invalid compaction flags");
-- 
2.55.0

